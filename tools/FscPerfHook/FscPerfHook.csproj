<Project Sdk="Microsoft.NET.Sdk">
  <!-- Startup hook (DOTNET_STARTUP_HOOKS) that writes runtime GC/JIT counters to $FSCPERF_STATS_FILE at process exit.
       Targets net8.0 so it loads on any newer runtime; the APIs used exist since .NET 6/7. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
